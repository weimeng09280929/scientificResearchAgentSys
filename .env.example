# Scientific Agent — 本地环境变量示例
# 复制为 .env 后填写自己的凭据；真实密钥不要提交到 Git。
# 已存在的系统环境变量优先于 .env；修改后重启服务。
#
# 当前主流程的 provider/model 请以 config/tasks.yaml 的任务项为准。
# 切换厂商需要同时修改任务路由，仅填写另一家的 key 不会自动切换。

# ===== 运行模式 =====
# true：架构演示，部分节点使用占位数据，不进行真实模型调用。
# false：真实调用已配置的服务，可能产生费用。
SRA_DRY_RUN=true

# ===== 当前任务路由使用的 provider：DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 如使用兼容网关，请填写该服务提供的地址，并核对 tasks.yaml 的模型标识。

# ===== 文献检索与 PDF 解析（可选）=====
# 不配置 Sciverse 时可尝试其他文献源；是否可用取决于网络与限流。
SCIVERSE_API_TOKEN=
# 云端解析可能上传文献，请先确认权限与隐私要求。
MINERU_API_KEY=
# MINERU_BASE_URL=https://api.mineru.net/v1

# ===== 嵌入服务（可选，独立于聊天模型）=====
# 当前 embedding 路由为 OpenAI；不配置不代表已启用语义向量检索。
OPENAI_API_KEY=

# ===== 其他模型 provider（可选，需修改 tasks.yaml 后才用于对应任务）=====
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SPARK_API_KEY=
# SPARK_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1/
# ANTHROPIC_API_KEY=
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# ===== 材料领域扩展（可选，不是通用主流程必填项）=====
# MATERIALS_PROJECT_API_KEY=

# ===== 高级配置（可选）=====
# 默认账号模式；先用 python -m tools.local_accounts --db <账号库路径> init/create 初始化。
SRA_AUTH_MODE=accounts
# 只对回环访问开放的注册；默认关闭，tools.serve_local 账号入口可显式启用。
# SRA_ALLOW_LOCAL_REGISTRATION=1
# SRA_DATA_ROOT=C:/sra-local-test
# SRA_ACCOUNTS_DB=C:/sra-local-test/accounts.db
# 仅绑定 127.0.0.1 的本地 HTTP 测试才可启用；默认 Cookie 为 Secure。
# SRA_AUTH_INSECURE_HTTP=1
# 无登录兼容须显式设 SRA_AUTH_MODE=local，仅允许回环客户端和回环 Host。
# SRA_TASKS_CONFIG_PATH=config/tasks.yaml
# SRA_WEB_PORT=8001
# SRA_SEED=42
#
# 产品流程止于 DESIGN（研究方案），不开放实验执行、结果新增或论文生成。
# 规则／演示模式也遵守边界；环境变量不能用来绕过服务端限制。
# Single-process scientific work admission. Counts include workers which are
# cancelling but have not exited. No waiting queue; sizes are integer bytes.
SRA_RESOURCE_HEAVY_USER=1
SRA_RESOURCE_HEAVY_GLOBAL=3
SRA_RESOURCE_RECEIVE_USER=2
SRA_RESOURCE_RECEIVE_GLOBAL=2
SRA_RESOURCE_FILE_BYTES=8388608
SRA_RESOURCE_BODY_BYTES=9437184
SRA_RESOURCE_FIELD_BYTES=4096
SRA_RESOURCE_HEADER_BYTES=8192
SRA_RESOURCE_SPOOL_BYTES=65536
SRA_RESOURCE_CHUNK_BYTES=65536
SRA_RESOURCE_RECEIVE_SECONDS=120
